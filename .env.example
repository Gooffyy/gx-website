# ==============================================================================
# GX MENU — DISCORD OAUTH2 & BOT CONFIGURATION
# ==============================================================================

# Server Port
PORT=8080
PORTAL_URL=http://localhost:8080/dashboard.html

# ------------------------------------------------------------------------------
# DISCORD DEVELOPER PORTAL (https://discord.com/developers/applications)
# ------------------------------------------------------------------------------
# 1. Create Application -> General Information -> Copy Application ID
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID_HERE

# 2. OAuth2 -> Client Secret -> Reset/Copy Secret
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET_HERE

# 3. OAuth2 -> Redirects -> Add: http://localhost:8080/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# 4. Bot -> Reset Token -> Copy Bot Token (Enable SERVER MEMBERS INTENT)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ------------------------------------------------------------------------------
# DISCORD SERVER (GUILD) SETTINGS
# ------------------------------------------------------------------------------
# Right click your Discord Server -> Copy Server ID (Enable Developer Mode in Discord)
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_SERVER_ID_HERE

# The exact role name given to buyers
CLIENT_ROLE_NAME=Client
